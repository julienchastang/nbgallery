html
  head
    meta charset="UTF-8"
    -if defined? nofollow
      meta name="robots" content="nofollow"
    -if defined? notebook.title
      title =notebook.title
    -elsif defined? subtitle and !subtitle.nil? and !subtitle.empty?
      title #{GalleryConfig.site.name} - #{subtitle}
    -else
      title #{GalleryConfig.site.name}

    ==favicon_link_tag "nb.ico"
    ==stylesheet_link_tag "application", media: "all"

div.center
  div.well id="errorLayout"
    a.logo-link href="#{root_path}"
      ==image_tag("nsf_official_logo.png", alt: "NSF", class: "logo-nsf")
      span.logo-divider aria-hidden="true"
      ==image_tag("unidata_horizontal.png", alt: "Unidata", class: "logo-unidata")
      span.sr-only Unidata Notebook Gallery home
    ==yield
